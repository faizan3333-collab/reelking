{
  "crons": [
    { "path": "/api/cron/sla-check", "schedule": "0 6 * * *" },
    { "path": "/api/cron/cleanup", "schedule": "0 3 * * *" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}